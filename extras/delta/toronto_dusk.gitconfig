# Toronto Dusk theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-dusk"]
    # General
    dark = true
    syntax-theme = none
    
    # Colors
    minus-style = "#ff8899"
    minus-emph-style = "#ff8899 bold"
    minus-non-emph-style = "#ff8899"
    plus-style = "#7fd2ff" 
    plus-emph-style = "#7fd2ff bold"
    plus-non-emph-style = "#7fd2ff"
    
    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#d0d0e8"
    line-numbers-right-style = "#d0d0e8"
    line-numbers-minus-style = "#ff8899"
    line-numbers-plus-style = "#7fd2ff"
    line-numbers-zero-style = "#d0d0e8"
    
    # File headers  
    file-style = "#f6f6f6 bold"
    file-decoration-style = "#7fd2ff ul"
    
    # Hunk headers
    hunk-header-style = "#7fd2ff bold"
    hunk-header-decoration-style = "#7fd2ff ul"
    
    # Commit style
    commit-style = "#b8860b bold"
    commit-decoration-style = "none"
