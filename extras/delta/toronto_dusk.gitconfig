# Toronto Dusk theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-dusk"]
    # General
    dark = true
    syntax-theme = none

    # Colors
    minus-style = "#c37b7c"
    minus-emph-style = "#c37b7c bold"
    minus-non-emph-style = "#c37b7c"
    plus-style = "#cdb073"
    plus-emph-style = "#cdb073 bold"
    plus-non-emph-style = "#cdb073"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#929089"
    line-numbers-right-style = "#929089"
    line-numbers-minus-style = "#c37b7c"
    line-numbers-plus-style = "#cdb073"
    line-numbers-zero-style = "#929089"

    # File headers
    file-style = "#d1cfc8 bold"
    file-decoration-style = "#cdb073 ul"

    # Hunk headers
    hunk-header-style = "#cdb073 bold"
    hunk-header-decoration-style = "#cdb073 ul"

    # Commit style
    commit-style = "#c6aa64 bold"
    commit-decoration-style = "none"
