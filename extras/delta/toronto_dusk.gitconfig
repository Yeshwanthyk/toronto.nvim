# Toronto Dusk theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-dusk"]
    # General
    dark = true
    syntax-theme = none

    # Colors
    minus-style = "#ce8585"
    minus-emph-style = "#ce8585 bold"
    minus-non-emph-style = "#ce8585"
    plus-style = "#d9bc7e"
    plus-emph-style = "#d9bc7e bold"
    plus-non-emph-style = "#d9bc7e"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#94918a"
    line-numbers-right-style = "#94918a"
    line-numbers-minus-style = "#ce8585"
    line-numbers-plus-style = "#d9bc7e"
    line-numbers-zero-style = "#94918a"

    # File headers
    file-style = "#d4d2cb bold"
    file-decoration-style = "#d9bc7e ul"

    # Hunk headers
    hunk-header-style = "#d9bc7e bold"
    hunk-header-decoration-style = "#d9bc7e ul"

    # Commit style
    commit-style = "#d2b56f bold"
    commit-decoration-style = "none"
