# Toronto Spring theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-spring"]
    # General
    dark = true
    syntax-theme = none

    # Colors
    minus-style = "#d19591"
    minus-emph-style = "#d19591 bold"
    minus-non-emph-style = "#d19591"
    plus-style = "#a8c6d6"
    plus-emph-style = "#a8c6d6 bold"
    plus-non-emph-style = "#a8c6d6"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#929aa5"
    line-numbers-right-style = "#929aa5"
    line-numbers-minus-style = "#d19591"
    line-numbers-plus-style = "#a8c6d6"
    line-numbers-zero-style = "#929aa5"

    # File headers
    file-style = "#d0d5dc bold"
    file-decoration-style = "#a8c6d6 ul"

    # Hunk headers
    hunk-header-style = "#a8c6d6 bold"
    hunk-header-decoration-style = "#a8c6d6 ul"

    # Commit style
    commit-style = "#d0b77e bold"
    commit-decoration-style = "none"
