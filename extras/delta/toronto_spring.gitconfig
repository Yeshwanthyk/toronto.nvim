# Toronto Spring theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-spring"]
    # General
    dark = true
    syntax-theme = none

    # Colors
    minus-style = "#c08581"
    minus-emph-style = "#c08581 bold"
    minus-non-emph-style = "#c08581"
    plus-style = "#96b4c4"
    plus-emph-style = "#96b4c4 bold"
    plus-non-emph-style = "#96b4c4"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#89919b"
    line-numbers-right-style = "#89919b"
    line-numbers-minus-style = "#c08581"
    line-numbers-plus-style = "#96b4c4"
    line-numbers-zero-style = "#89919b"

    # File headers
    file-style = "#cbcfd6 bold"
    file-decoration-style = "#96b4c4 ul"

    # Hunk headers
    hunk-header-style = "#96b4c4 bold"
    hunk-header-decoration-style = "#96b4c4 ul"

    # Commit style
    commit-style = "#bea66d bold"
    commit-decoration-style = "none"
