# Toronto Spring theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-spring"]
    # General
    dark = true
    syntax-theme = none
    
    # Colors
    minus-style = "#ffb4a2"
    minus-emph-style = "#ffb4a2 bold"
    minus-non-emph-style = "#ffb4a2"
    plus-style = "#7cc9ff" 
    plus-emph-style = "#7cc9ff bold"
    plus-non-emph-style = "#7cc9ff"
    
    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#6f7b8f"
    line-numbers-right-style = "#6f7b8f"
    line-numbers-minus-style = "#ffb4a2"
    line-numbers-plus-style = "#7cc9ff"
    line-numbers-zero-style = "#6f7b8f"
    
    # File headers  
    file-style = "#dfe5f0 bold"
    file-decoration-style = "#7cc9ff ul"
    
    # Hunk headers
    hunk-header-style = "#7cc9ff bold"
    hunk-header-decoration-style = "#7cc9ff ul"
    
    # Commit style
    commit-style = "#ffd580 bold"
    commit-decoration-style = "none"
