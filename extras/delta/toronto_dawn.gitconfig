# Toronto Dawn theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-dawn"]
    # General
    dark = false
    syntax-theme = none

    # Colors
    minus-style = "#b83c3c"
    minus-emph-style = "#b83c3c bold"
    minus-non-emph-style = "#b83c3c"
    plus-style = "#a55718"
    plus-emph-style = "#a55718 bold"
    plus-non-emph-style = "#a55718"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#746c64"
    line-numbers-right-style = "#746c64"
    line-numbers-minus-style = "#b83c3c"
    line-numbers-plus-style = "#a55718"
    line-numbers-zero-style = "#746c64"

    # File headers
    file-style = "#2c2420 bold"
    file-decoration-style = "#a55718 ul"

    # Hunk headers
    hunk-header-style = "#a55718 bold"
    hunk-header-decoration-style = "#a55718 ul"

    # Commit style
    commit-style = "#8b6418 bold"
    commit-decoration-style = "none"
