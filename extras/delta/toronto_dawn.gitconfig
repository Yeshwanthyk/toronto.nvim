# Toronto Dawn theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-dawn"]
    # General
    dark = false
    syntax-theme = none

    # Colors
    minus-style = "#9b1d24"
    minus-emph-style = "#9b1d24 bold"
    minus-non-emph-style = "#9b1d24"
    plus-style = "#893e00"
    plus-emph-style = "#893e00 bold"
    plus-non-emph-style = "#893e00"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#686059"
    line-numbers-right-style = "#686059"
    line-numbers-minus-style = "#9b1d24"
    line-numbers-plus-style = "#893e00"
    line-numbers-zero-style = "#686059"

    # File headers
    file-style = "#2f2722 bold"
    file-decoration-style = "#893e00 ul"

    # Hunk headers
    hunk-header-style = "#893e00 bold"
    hunk-header-decoration-style = "#893e00 ul"

    # Commit style
    commit-style = "#714b00 bold"
    commit-decoration-style = "none"
