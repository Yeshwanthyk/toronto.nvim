# Toronto Dawn theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-dawn"]
    # General
    dark = false
    syntax-theme = none
    
    # Colors
    minus-style = "#ff5c93"
    minus-emph-style = "#ff5c93 bold"
    minus-non-emph-style = "#ff5c93"
    plus-style = "#379cff" 
    plus-emph-style = "#379cff bold"
    plus-non-emph-style = "#379cff"
    
    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#56607b"
    line-numbers-right-style = "#56607b"
    line-numbers-minus-style = "#ff5c93"
    line-numbers-plus-style = "#379cff"
    line-numbers-zero-style = "#56607b"
    
    # File headers  
    file-style = "#101010 bold"
    file-decoration-style = "#379cff ul"
    
    # Hunk headers
    hunk-header-style = "#379cff bold"
    hunk-header-decoration-style = "#379cff ul"
    
    # Commit style
    commit-style = "#f28a3a bold"
    commit-decoration-style = "none"
