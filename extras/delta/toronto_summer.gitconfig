# Toronto Summer theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-summer"]
    # General
    dark = false
    syntax-theme = none
    
    # Colors
    minus-style = "#ff5c8f"
    minus-emph-style = "#ff5c8f bold"
    minus-non-emph-style = "#ff5c8f"
    plus-style = "#ff9f1c" 
    plus-emph-style = "#ff9f1c bold"
    plus-non-emph-style = "#ff9f1c"
    
    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#9d816d"
    line-numbers-right-style = "#9d816d"
    line-numbers-minus-style = "#ff5c8f"
    line-numbers-plus-style = "#ff9f1c"
    line-numbers-zero-style = "#9d816d"
    
    # File headers  
    file-style = "#22160f bold"
    file-decoration-style = "#ff9f1c ul"
    
    # Hunk headers
    hunk-header-style = "#ff9f1c bold"
    hunk-header-decoration-style = "#ff9f1c ul"
    
    # Commit style
    commit-style = "#ff9f1c bold"
    commit-decoration-style = "none"
