# Toronto Summer theme for Delta
# https://github.com/your-username/toronto.nvim
# Add this to your .gitconfig in [delta] section or include this file

[delta "toronto-summer"]
    # General
    dark = false
    syntax-theme = none

    # Colors
    minus-style = "#97363c"
    minus-emph-style = "#97363c bold"
    minus-non-emph-style = "#97363c"
    plus-style = "#804704"
    plus-emph-style = "#804704 bold"
    plus-non-emph-style = "#804704"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#765e4e"
    line-numbers-right-style = "#765e4e"
    line-numbers-minus-style = "#97363c"
    line-numbers-plus-style = "#804704"
    line-numbers-zero-style = "#765e4e"

    # File headers
    file-style = "#31251d bold"
    file-decoration-style = "#804704 ul"

    # Hunk headers
    hunk-header-style = "#804704 bold"
    hunk-header-decoration-style = "#804704 ul"

    # Commit style
    commit-style = "#72570b bold"
    commit-decoration-style = "none"
