# Toronto Dusk theme for Tmux
# https://github.com/your-username/toronto.nvim

# Status bar
set -g status-style "bg=#0d0e11,fg=#d4d2cb"
set -g status-left-style "bg=#d9bc7e,fg=#08090b,bold"
set -g status-right-style "bg=#0d0e11,fg=#94918a"

# Window status
set -g window-status-style "bg=#0d0e11,fg=#94918a"
set -g window-status-current-style "bg=#d9bc7e,fg=#08090b,bold"
set -g window-status-activity-style "bg=#d2b56f,fg=#08090b"
set -g window-status-bell-style "bg=#ce8585,fg=#08090b"

# Panes
set -g pane-border-style "fg=#27282e"
set -g pane-active-border-style "fg=#d9bc7e"

# Messages
set -g message-style "bg=#cf9b73,fg=#08090b,bold"
set -g message-command-style "bg=#d9bc7e,fg=#08090b,bold"

# Copy mode
set -g mode-style "bg=#1c1d22,fg=#d4d2cb"

# Clock
set -g clock-mode-colour "#d9bc7e"
