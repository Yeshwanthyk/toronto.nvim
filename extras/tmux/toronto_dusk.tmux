# Toronto Dusk theme for Tmux
# https://github.com/your-username/toronto.nvim

# Status bar
set -g status-style "bg=#1d1e21,fg=#d1cfc8"
set -g status-left-style "bg=#cdb073,fg=#161719,bold"
set -g status-right-style "bg=#1d1e21,fg=#929089"

# Window status
set -g window-status-style "bg=#1d1e21,fg=#929089"
set -g window-status-current-style "bg=#cdb073,fg=#161719,bold"
set -g window-status-activity-style "bg=#c6aa64,fg=#161719"
set -g window-status-bell-style "bg=#c37b7c,fg=#161719"

# Panes
set -g pane-border-style "fg=#37383f"
set -g pane-active-border-style "fg=#cdb073"

# Messages
set -g message-style "bg=#c49169,fg=#161719,bold"
set -g message-command-style "bg=#cdb073,fg=#161719,bold"

# Copy mode
set -g mode-style "bg=#2b2c32,fg=#d1cfc8"

# Clock
set -g clock-mode-colour "#cdb073"
