# Toronto Dusk theme for Tmux
# https://github.com/your-username/toronto.nvim

# Status bar
set -g status-style "bg=#080809,fg=#c8c4b8"
set -g status-left-style "bg=#d7b66f,fg=#050506,bold"
set -g status-right-style "bg=#080809,fg=#7d7970"

# Window status
set -g window-status-style "bg=#080809,fg=#7d7970"
set -g window-status-current-style "bg=#d7b66f,fg=#050506,bold"
set -g window-status-activity-style "bg=#bfa66a,fg=#050506"
set -g window-status-bell-style "bg=#c77575,fg=#050506"

# Panes
set -g pane-border-style "fg=#1a1a1a"
set -g pane-active-border-style "fg=#d7b66f"

# Messages
set -g message-style "bg=#c58f62,fg=#050506,bold"
set -g message-command-style "bg=#d7b66f,fg=#050506,bold"

# Copy mode
set -g mode-style "bg=#171512,fg=#c8c4b8"

# Clock
set -g clock-mode-colour "#d7b66f"
