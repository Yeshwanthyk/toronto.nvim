# Toronto Dawn theme for Tmux
# https://github.com/your-username/toronto.nvim

# Status bar
set -g status-style "bg=#f4f1ec,fg=#2c2420"
set -g status-left-style "bg=#a55718,fg=#faf8f5,bold"
set -g status-right-style "bg=#f4f1ec,fg=#746c64"

# Window status
set -g window-status-style "bg=#f4f1ec,fg=#746c64"
set -g window-status-current-style "bg=#a55718,fg=#faf8f5,bold"
set -g window-status-activity-style "bg=#8b6418,fg=#faf8f5"
set -g window-status-bell-style "bg=#b83c3c,fg=#faf8f5"

# Panes
set -g pane-border-style "fg=#d8d0c4"
set -g pane-active-border-style "fg=#a55718"

# Messages
set -g message-style "bg=#aa4f29,fg=#faf8f5,bold"
set -g message-command-style "bg=#a55718,fg=#faf8f5,bold"

# Copy mode
set -g mode-style "bg=#e4dcd0,fg=#2c2420"

# Clock
set -g clock-mode-colour "#a55718"
