# Toronto Dawn theme for Tmux
# https://github.com/your-username/toronto.nvim

# Status bar
set -g status-style "bg=#e7e4df,fg=#2f2722"
set -g status-left-style "bg=#893e00,fg=#edece9,bold"
set -g status-right-style "bg=#e7e4df,fg=#686059"

# Window status
set -g window-status-style "bg=#e7e4df,fg=#686059"
set -g window-status-current-style "bg=#893e00,fg=#edece9,bold"
set -g window-status-activity-style "bg=#714b00,fg=#edece9"
set -g window-status-bell-style "bg=#9b1d24,fg=#edece9"

# Panes
set -g pane-border-style "fg=#c6beb2"
set -g pane-active-border-style "fg=#893e00"

# Messages
set -g message-style "bg=#8d3508,fg=#edece9,bold"
set -g message-command-style "bg=#893e00,fg=#edece9,bold"

# Copy mode
set -g mode-style "bg=#d6cec2,fg=#2f2722"

# Clock
set -g clock-mode-colour "#893e00"
