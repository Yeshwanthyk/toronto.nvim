# Toronto Spring theme for Tmux
# https://github.com/your-username/toronto.nvim

# Status bar
set -g status-style "bg=#101622,fg=#c3cad2"
set -g status-left-style "bg=#9bb7c9,fg=#0b0f17,bold"
set -g status-right-style "bg=#101622,fg=#78828d"

# Window status
set -g window-status-style "bg=#101622,fg=#78828d"
set -g window-status-current-style "bg=#9bb7c9,fg=#0b0f17,bold"
set -g window-status-activity-style "bg=#c4aa70,fg=#0b0f17"
set -g window-status-bell-style "bg=#c58b86,fg=#0b0f17"

# Panes
set -g pane-border-style "fg=#1d2632"
set -g pane-active-border-style "fg=#9bb7c9"

# Messages
set -g message-style "bg=#8eb0c8,fg=#0b0f17,bold"
set -g message-command-style "bg=#9bb7c9,fg=#0b0f17,bold"

# Copy mode
set -g mode-style "bg=#1b2635,fg=#c3cad2"

# Clock
set -g clock-mode-colour "#9bb7c9"
