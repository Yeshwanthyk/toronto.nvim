# Toronto Summer theme for Tmux
# https://github.com/your-username/toronto.nvim

# Status bar
set -g status-style "bg=#fff6e8,fg=#22160f"
set -g status-left-style "bg=#ff9f1c,fg=#fffaf2,bold"
set -g status-right-style "bg=#fff6e8,fg=#9d816d"

# Window status
set -g window-status-style "bg=#fff6e8,fg=#9d816d"
set -g window-status-current-style "bg=#ff9f1c,fg=#fffaf2,bold"
set -g window-status-activity-style "bg=#ff9f1c,fg=#fffaf2"
set -g window-status-bell-style "bg=#ff5c8f,fg=#fffaf2"

# Panes
set -g pane-border-style "fg=#e3c3a1"
set -g pane-active-border-style "fg=#ff9f1c"

# Messages
set -g message-style "bg=#8b6dff,fg=#fffaf2,bold"
set -g message-command-style "bg=#ff9f1c,fg=#fffaf2,bold"

# Copy mode
set -g mode-style "bg=#ffd9c6,fg=#22160f"

# Clock
set -g clock-mode-colour "#ff9f1c"
