# Toronto Summer theme for Tmux
# https://github.com/your-username/toronto.nvim

# Status bar
set -g status-style "bg=#f4e6d2,fg=#281d15"
set -g status-left-style "bg=#8f551a,fg=#fbf2e4,bold"
set -g status-right-style "bg=#f4e6d2,fg=#785f4f"

# Window status
set -g window-status-style "bg=#f4e6d2,fg=#785f4f"
set -g window-status-current-style "bg=#8f551a,fg=#fbf2e4,bold"
set -g window-status-activity-style "bg=#80641f,fg=#fbf2e4"
set -g window-status-bell-style "bg=#a74449,fg=#fbf2e4"

# Panes
set -g pane-border-style "fg=#dec5a6"
set -g pane-active-border-style "fg=#8f551a"

# Messages
set -g message-style "bg=#895743,fg=#fbf2e4,bold"
set -g message-command-style "bg=#8f551a,fg=#fbf2e4,bold"

# Copy mode
set -g mode-style "bg=#e7cfad,fg=#281d15"

# Clock
set -g clock-mode-colour "#8f551a"
