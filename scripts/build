#!/bin/bash

# Toronto.nvim build script
# Generates external tool themes for all variants

set -o errexit
set -o nounset
set -o pipefail

echo "Generating Toronto themes for external tools..."
echo

# Generate themes using Neovim. Keeping the Lua in a real file makes parse or
# runtime failures propagate to this script instead of being reported as success.
nvim --headless --noplugin -u NONE -l scripts/build.lua

echo
echo "All themes generated successfully."
echo "Check the extras/ directory for the generated files."
echo
echo "Usage:"
echo "  Tmux:     source extras/tmux/toronto_dusk.tmux"
echo "  FZF:      source extras/fzf/toronto_dusk.sh"
echo "  Delta:    include extras/delta/toronto_dusk.gitconfig in your .gitconfig"
echo "  Alacritty: include extras/alacritty/toronto_dusk.toml in your alacritty.toml"
